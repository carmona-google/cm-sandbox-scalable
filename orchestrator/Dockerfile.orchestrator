FROM python:3.11-slim

WORKDIR /app

# Create non-root user
RUN useradd -m -u 1000 orchestrator

COPY orchestrator/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY orchestrator /app/orchestrator
RUN chown -R orchestrator:orchestrator /app

USER orchestrator

ENV PORT=8080
EXPOSE 8080

CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "2", "--threads", "4", "orchestrator.app:create_app()"]
